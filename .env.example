# Copy to .env for local runs. Never commit .env.
META_API_KEY=
BASETEN_API_KEY=

# Needed to create projects on a public deployment (any long random string)
SAKSI_CREATE_TOKEN=

# live | record | replay
SAKSI_LLM_MODE=live

# Optional: USD per million tokens, used only for cost reporting
# SAKSI_PRICE_META_INPUT_PER_M=
# SAKSI_PRICE_META_OUTPUT_PER_M=
# SAKSI_PRICE_BASETEN_INPUT_PER_M=
# SAKSI_PRICE_BASETEN_OUTPUT_PER_M=
